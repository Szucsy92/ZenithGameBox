<resources>
    <style name="Theme.Zenith" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/console_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Zenith.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/console_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/launch_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Zenith</item>
    </style>
</resources>
